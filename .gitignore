# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or app, you might want to share your .python-version if utilizing it, otherwise:
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you choose not to include it:
#Pipfile.lock

# poetry
#   According to poetry documentation, poetry.lock should be committed.
#   But if you choose not to commit it:
#poetry.lock

# pdm
#   Similar to Poetry and Pipenv, pdm.lock is to be committed.
#   But if you choose not to commit it:
#pdm.lock

# PEP 582 project packages
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

